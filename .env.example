# Copy to .env.local and fill in values. NEVER commit real secrets.

# Contact form — Resend (required in production for /api/send-email)
RESEND_API_KEY=

# Live reviews through ScrapingBee (optional; without it the site falls back
# to the archived reviews in config/site.config.ts)
SCRAPINGBEE_API_KEY=
# Optional: "stealth" makes the Thumbtack scrape use the stealth proxy
# (75 credits/call) instead of the premium proxy (25 credits/call).
SCRAPINGBEE_PROXY=

# Durable rate limiting for the contact form (optional but recommended in
# production). When a Vercel Marketplace KV (Upstash) store is attached, these
# two variables are injected automatically. Without them the form falls back
# to per-instance in-memory limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set automatically by Vercel (VERCEL_URL per deployment, VERCEL=1). Used by
# lib/origin-check.ts to allow the form on preview deployments. Do not set
# these by hand.
VERCEL_URL=
VERCEL=
